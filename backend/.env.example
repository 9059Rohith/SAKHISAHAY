# Application mode: development, test, staging or production.
APP_ENV=development
# Turn off debug in production.
DEBUG=false
# Generate with python -c "import secrets; print(secrets.token_hex(48))".
SECRET_KEY=development-only-replace-with-at-least-64-random-characters-before-deployment
# Private MongoDB server URI. For local compose use mongodb://mongo:27017.
MONGODB_URI=mongodb://localhost:27017
# Use a separate database for tests.
MONGODB_DB_NAME=sakhisahay
# Connection pool limits, per worker.
MONGODB_MAX_POOL_SIZE=30
MONGODB_MIN_POOL_SIZE=0
# Explicit frontend origins separated by commas. No wildcard in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Trusted request hosts. Add your custom hostname if applicable.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,*.vercel.app
# Absolute frontend URL used in email links. HTTPS in production.
FRONTEND_URL=http://localhost:5173
# Short-lived access token and rotating refresh cookie lifetimes.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Database-backed rate limiting; enabled in production.
RATE_LIMIT_ENABLED=true
# Private OpenAI key, used only by the Python server.
OPENAI_API_KEY=
# Model must be accessible to your OpenAI project.
OPENAI_MODEL=gpt-4.1-mini
# Optional transactional SMTP. Port 465 uses TLS; other ports use STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Optional first administrator provisioning through scripts/seed.py.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
# Operational metadata.
LOG_LEVEL=INFO
GIT_SHA=development
BUILD_TIME=local
